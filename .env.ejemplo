# Copia este fichero a .env y rellena lo que vayas a usar.

# IP de la interfaz EXPUESTA, donde escuchan los honeypots. Obligatoria:
# docker compose se niega a arrancar sin ella para no publicar los
# honeypots en todas las interfaces, incluida la de tu red interna.
K0POT_IP_EXPUESTA=192.168.100.10

#
# Las claves son la SEMILLA de una instalacion nueva: al arrancar por
# primera vez se guardan en la base de datos y a partir de ahi se editan
# desde Ajustes. Cambiar el .env despues no tiene efecto.
#
# k0Pot funciona sin ninguna de estas claves: sin AbuseIPDB no enriquece
# las IPs, y sin proveedor de IA los informes los redactan las reglas.

# Contexto de las IPs atacantes. Gratis: 1.000 consultas al dia.
# https://www.abuseipdb.com/account/api
K0POT_CLAVE_ABUSEIPDB=

# Informes en lenguaje natural.
# Vale cualquier API compatible con OpenAI: Groq, OpenRouter, Mistral,
# u Ollama en local (K0POT_URL_BASE=http://localhost:11434/v1).
K0POT_PROVEEDOR=compatible
K0POT_URL_BASE=https://api.groq.com/openai/v1
K0POT_MODELO=openai/gpt-oss-120b
K0POT_CLAVE_COMPATIBLE=

# Alternativa: Anthropic directamente.
# K0POT_PROVEEDOR=anthropic
# K0POT_CLAVE_ANTHROPIC=

# Se siguen aceptando los nombres antiguos con prefijo HONEY_, para no
# romper instalaciones anteriores al cambio de nombre.
