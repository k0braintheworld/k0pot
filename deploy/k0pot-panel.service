[Unit]
Description=k0Pot — panel web
Documentation=https://github.com/k0braintheworld/k0pot
After=network-online.target k0pot-collector.service
Wants=network-online.target
# Si el binario falla en bucle, systemd deja de insistir en vez de calentar
# la maquina para siempre. Van en [Unit]: en [Service] se ignoran.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/k0pot
ExecStart=%h/k0pot/k0pot -web 0.0.0.0:8080
Restart=always
RestartSec=5s

# ── Aislamiento del proceso ─────────────────────────────────────────────
#
# El panel sirve HTTP sin cifrar y ejecuta el mismo binario que las
# trampas, con el mismo usuario, que pertenece a los grupos sudo y docker
# -y el grupo docker equivale a root. Se encierra igual que el collector:
# un sandbox que solo cubre la mitad de los procesos no cubre nada.

# Estas cuatro NO se pueden usar en una unidad de USUARIO, aunque el
# fichero se acepte sin quejarse: PrivateDevices, ProtectKernelModules,
# ProtectKernelLogs y ProtectClock implican soltar capacidades del
# bounding set, y eso exige CAP_SETPCAP, que un proceso de usuario no
# tiene. El servicio arranca y muere con 218/CAPABILITIES.
#
# Para poder aplicarlas hace falta una unidad de SISTEMA con User=k0pot.
# Ver deploy/sistema/ para esa variante, que requiere root para instalar.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/k0pot/data
# NO se pone InaccessiblePaths=%h/.ssh: systemd la acepta, systemctl show
# la da por configurada y no hace absolutamente nada. En una unidad de
# USUARIO la proteccion del home se ignora -el propio gestor de sesion vive
# ahi-, asi que ni ProtectHome=tmpfs esconde nada. Comprobado mirando
# /proc/PID/mountinfo: cero montajes bajo /home.
#
# Se deja fuera a proposito: una directiva inerte es peor que su ausencia,
# porque quien lea el fichero dara por protegido algo que no lo esta. Para
# ocultar de verdad ~/.ssh hace falta la variante de deploy/sistema/.
ProtectProc=invisible
ProtectKernelTunables=true
ProtectControlGroups=true
# ProtectHostname se omite: necesita un espacio de nombres UTS que systemd
# no puede crear aqui, y solo genera un aviso en cada arranque.
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
# CapabilityBoundingSet no se pone: soltar capacidades es una operacion
# privilegiada y una unidad de USUARIO no puede hacerla -systemd falla con
# "Failed to drop capabilities" y el servicio no arranca. Da igual: un
# proceso de usuario no tiene ninguna capacidad que soltar.
# Sin AF_UNIX se cierra, POR DISENO, el socket de Docker: hasta ahora
# quedaba fuera de alcance solo como efecto colateral de
# ProtectSystem=strict, que es fragil porque depende de un detalle de
# montaje y no de una regla explicita.
# AF_NETLINK hace falta para enumerar las interfaces de red: es lo que usa
# Go por debajo de net.Interfaces(). Sin el, el panel no puede listar la red
# y -al fallar esa consulta- no llegaba a abrirse la ventana de Ajustes
# entera. No abre ninguna via hacia fuera: es una interfaz con el kernel.
# El socket de Docker sigue cerrado, porque ese es AF_UNIX.
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
UMask=0077
MemoryMax=256M

[Install]
WantedBy=default.target
