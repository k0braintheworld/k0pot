[Unit]
Description=k0Pot — Cowrie (SSH y Telnet) en contenedor
Documentation=https://github.com/k0braintheworld/k0pot
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/usr/share/k0pot
EnvironmentFile=/etc/k0pot/k0pot.env
# Lo lanza root porque hablar con Docker equivale a ser root, y precisamente
# por eso el collector NO lo hace: asi el proceso expuesto a internet no
# necesita acceso al socket de Docker para nada.
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
